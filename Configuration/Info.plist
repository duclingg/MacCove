<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the Info.plist Xcode generates from build settings.
	     Holds only keys that can't be set as INFOPLIST_KEY_ build settings. -->
	<key>NSBonjourServices</key>
	<array>
		<!-- Read each AirPlay device's model so the island shows the right icon. -->
		<string>_airplay._tcp</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<!-- maccove://xcode/started and so on, opened by the scripts Xcode's
			     Behaviors run as a build starts, succeeds or fails. -->
			<key>CFBundleURLName</key>
			<string>com.ducling.MacCove</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>maccove</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
